APP_NAME="AI Test Platform"
APP_ENV=local

# Moonshot asset directories. Copy this file to .env after moonshot-data is installed.
ATTACK_MODULES="./data/moonshot-data/attack-modules"
BOOKMARKS="./data/moonshot-data/generated-outputs/bookmarks"
CONNECTORS="./data/moonshot-data/connectors"
CONNECTORS_ENDPOINTS="./data/moonshot-data/connectors-endpoints"
CONTEXT_STRATEGY="./data/moonshot-data/context-strategy"
COOKBOOKS="./data/moonshot-data/cookbooks"
DATABASES="./data/moonshot-data/generated-outputs/databases"
DATABASES_MODULES="./data/moonshot-data/databases-modules"
DATASETS="./data/moonshot-data/datasets"
IO_MODULES="./data/moonshot-data/io-modules"
METRICS="./data/moonshot-data/metrics"
PROMPT_TEMPLATES="./data/moonshot-data/prompt-templates"
RECIPES="./data/moonshot-data/recipes"
RESULTS="./data/moonshot-data/generated-outputs/results"
RESULTS_MODULES="./data/moonshot-data/results-modules"
RUNNERS="./data/moonshot-data/generated-outputs/runners"
RUNNERS_MODULES="./data/moonshot-data/runners-modules"

# Shared control-model governance for Attack Agent and other AI model calls.
AI_MODEL_MAX_CONCURRENCY=3
AI_MODEL_QUEUE_TIMEOUT_SECONDS=90
ATTACK_AGENT_MODEL_CONCURRENCY=3
AI_PROVIDER_RETRY_BASE_SECONDS=0.5
AI_PROVIDER_RETRY_MAX_SECONDS=8
AI_PROVIDER_RETRY_JITTER_RATIO=0.25
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AI_PROVIDER_CIRCUIT_RECOVERY_SECONDS=30
